/* Sasso Radar Tower — Plymouth boot splash script.
 *
 * Colours are filled in by generate_logo.py from the currently
 * configured theme (amber/mono, flugradar/display/theme.py). The source
 * of truth is system/plymouth/sasso-radar.script.tmpl in the git repo --
 * a copy of it, with colours substituted, is written to
 * /usr/share/plymouth/themes/sasso-radar/ on every install.sh run and
 * overwritten each time, so edit the .tmpl, not a copy found elsewhere.
 *
 * logo.png bakes in BOTH the rings graphic and the "SASSO RADAR TOWER"
 * title, composed unrotated and then rotated once as a whole by
 * generate_logo.py -- the FlightPanel enclosure mounts the DSI panel
 * physically rotated 90°, and Plymouth runs before flugradar-display
 * (no pygame yet to do that compensation itself). That's also why there
 * is only one static sprite here now instead of separate logo/title
 * sprites: rotating each independently at the script level would need
 * Plymouth's own Image.Rotate(), whose exact rotation direction isn't
 * verifiable without the real panel, whereas PIL's rotation was checked
 * directly against pygame's (see generate_logo.py's _draw_logo()).
 */

Window.SetBackgroundTopColor({{BG_R}}, {{BG_G}}, {{BG_B}});
Window.SetBackgroundBottomColor({{BG_R}}, {{BG_G}}, {{BG_B}});

logo_image = Image("logo.png");
logo_sprite = Sprite(logo_image);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_image.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - logo_image.GetHeight() / 2);

/* Centre of the live sweep dot's orbit: where the rings' own centre
 * ended up inside the rotated logo.png (generate_logo.py's
 * dot_offset return value), placed relative to the sprite's actual
 * on-screen position. A circular orbit doesn't need rotating itself --
 * a circle is rotation-symmetric about its own centre -- only this
 * centre point does. */
ring_centre_x = logo_sprite.GetX() + {{DOT_OFFSET_X}};
ring_centre_y = logo_sprite.GetY() + {{DOT_OFFSET_Y}};

progress = 0;

fun refresh_callback() {
    progress++;
    sweep_angle = progress * 0.05;

    dot_x = ring_centre_x + Math.Cos(sweep_angle) * 60;
    dot_y = ring_centre_y + Math.Sin(sweep_angle) * 60;

    dot_image = Image.Text(".", {{ACCENT_R}}, {{ACCENT_G}}, {{ACCENT_B}}, "Inter");
    dot_sprite = Sprite(dot_image);
    dot_sprite.SetX(dot_x);
    dot_sprite.SetY(dot_y);
}

Plymouth.SetRefreshFunction(refresh_callback);
