# Sasso Radar Tower — environment configuration
# Copy to .env and adjust values as needed.
# Priority: these env vars > portal settings (web UI) > built-in defaults.

# --- Location & radar ---

# Home location (lat/lon in decimal degrees)
FLUGRADAR_HOME_LAT=47.3769
FLUGRADAR_HOME_LON=8.5417

# Scan radius in kilometres
FLUGRADAR_RADIUS_KM=100

# Poll interval for live positions (seconds)
FLUGRADAR_POLL_INTERVAL=3

# Distance display unit: km | sm | nm
FLUGRADAR_DISTANCE_UNIT=km

# Minimum altitude filter (feet) — aircraft below this are hidden
FLUGRADAR_MIN_ALT_FT=0

# Highlight emergency squawks / military traffic; show only highlighted
# traffic if both are on and you want just that
FLUGRADAR_HIGHLIGHT_EMERGENCY=true
FLUGRADAR_HIGHLIGHT_MILITARY=true
FLUGRADAR_ONLY_HIGHLIGHTED=false

# --- Map ---

# carto_dark | carto_light | osm | none
MAP_PROVIDER=carto_dark

# RainViewer rain radar overlay (no key required)
RAINVIEWER_ENABLED=true

# Cap on the on-disk map tile cache (all providers combined: CARTO/OSM/
# openAIP/RainViewer), oldest tiles evicted first once exceeded
FLUGRADAR_TILE_CACHE_MAX_MB=300

# Map tile brightness, 0-100 (dims the base map under the radar chrome)
MAP_BRIGHTNESS=40

# --- Display ---

# Colour theme: amber | mono
FLUGRADAR_THEME=amber

# Aircraft icon set: detailed (licensed SVG set) | simple (hand-drawn shapes)
FLUGRADAR_AIRCRAFT_ICON_SET=detailed

# Radar chrome toggles
FLUGRADAR_SHOW_COMPASS=true
FLUGRADAR_SHOW_SWEEP=true
FLUGRADAR_SHOW_RINGS=true
FLUGRADAR_SHOW_AIRCRAFT_TAGS=true

# Auto-return to clock screen after N seconds of no interaction (0 = off)
FLUGRADAR_AUTO_CLOCK_S=300

# Screen brightness, 0-100 -- a software dim overlay, not a hardware
# backlight control (no sysfs path is assumed for every panel/driver)
FLUGRADAR_BRIGHTNESS=100

# Night mode: caps brightness to FLUGRADAR_NIGHT_MODE_BRIGHTNESS during the
# HH:MM window (wraps past midnight, e.g. 22:00-06:00)
FLUGRADAR_NIGHT_MODE_ENABLED=false
FLUGRADAR_NIGHT_MODE_START=22:00
FLUGRADAR_NIGHT_MODE_END=06:00
FLUGRADAR_NIGHT_MODE_BRIGHTNESS=30

# Temperature unit: c | f. Clock format: 24h | 12h
FLUGRADAR_TEMPERATURE_UNIT=c
FLUGRADAR_TIME_FORMAT=24h

# Display backend: desktop (X11/Xwayland, for development/Pi Connect)
#                  kiosk   (KMS/DRM, direct to panel without desktop)
DISPLAY_BACKEND=desktop

# Data directory for caches, cached settings.json, aircraft photos, tiles
# (defaults to ~/.local/share/flugradar)
# FLUGRADAR_DATA_DIR=

# --- Flight/route/airline enrichment ---
# Priority: AirLabs (if AIRLABS_API_KEY set) > adsbdb (free, default) > none.

# adsbdb.com needs no key. Enable/disable it, and how many of the nearest
# aircraft get background-enriched per cycle (throttled, one at a time).
ADSBDB_ENABLED=true
ADSBDB_ENRICH_NEAREST=20

# Show an adsbdb/airport-data.com aircraft photo as a fallback when
# planespotters has none. Off by default: adsbdb gives no per-photo
# photographer credit, only a blanket source note.
AIRCRAFT_PHOTOS_ENABLED=false

# Cap on the shared aircraft-photo cache directory (planespotters + adsbdb)
FLUGRADAR_PHOTO_CACHE_MAX_MB=200

# --- Optional API keys (leave empty to run with adsb.fi + adsbdb only) ---

FR24_API_KEY=
TOMORROW_API_KEY=
AIRLABS_API_KEY=

# openAIP: free account required for a client key (https://www.openaip.net
# -> profile -> API Clients). Adds a transparent aviation overlay
# (airspaces/airports/navaids) on top of the map background.
# CC BY-NC 4.0 licensed data — non-commercial use only.
OPENAIP_API_KEY=
OPENAIP_OVERLAY_ENABLED=true

# --- WLAN watchdog (flugradar-network-watchdog service) ---
# Read only by the watchdog service, not the portal.

# No WLAN at all after this many seconds since boot -> show the on-device
# WLAN screen immediately. Skipped entirely (screen shown right away) if
# NetworkManager has no saved WLAN profile at all yet (brand-new device).
WIFI_BOOT_GRACE_S=45

# A previously-working WLAN connection drops -> wait this long (tolerating
# e.g. a router reboot) before showing the WLAN screen. Resets if the
# connection comes back on its own within this window.
WIFI_OUTAGE_TOLERANCE_S=300

# Wifi interface name, in the rare case it isn't wlan0.
WIFI_INTERFACE=wlan0
